# ---------------------------------------------------------------------------
# EventLens backend configuration. Copy to `.env` and edit.
# ---------------------------------------------------------------------------

# PostgreSQL 16 with the pgvector extension (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://eventlens:CHANGE_ME_DB_PASSWORD@localhost:5432/eventlens

# Redis for the RQ job queue and rate limiting.
REDIS_URL=redis://localhost:6379/0

# Where photos are stored. nginx serves this directory at PUBLIC_PHOTOS_URL.
PHOTOS_DIR=/srv/eventlens/photos
PUBLIC_PHOTOS_URL=/photos

# Keep uploaded originals (incl. HEIC) under PHOTOS_DIR/<event>/original/.
# false = only the 1600px "full" and 400px "thumb" JPEGs are kept (~300 KB/photo).
KEEP_ORIGINALS=false

# Local development only: the API serves PHOTOS_DIR at /photos (no nginx needed).
# Keep false in production — nginx serves photos.
SERVE_PHOTOS=false

# Directory containing the two ONNX models (scripts/download_models.py).
MODELS_DIR=./models

# The single admin login (created/updated automatically when the API starts;
# any other admin accounts are removed).
# !! CHANGE ADMIN_PASSWORD on a public server — 123456 is guessed instantly. !!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# HS256 signing secret for admin tokens. At least 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRE_MINUTES=480

# Allowed browser origin(s), comma-separated. Your public site URL.
CORS_ORIGIN=https://photos.example.com

# Cosine similarity needed for a match (0.30–0.45). 0.363 is OpenCV's
# recommended value for SFace. Raise if wrong people appear; lower if photos
# are missing. See README "Threshold tuning".
MATCH_THRESHOLD=0.363

# Max selfies per search (1–3).
MAX_SELFIES=3

# Indexing worker processes (default: CPU cores - 1).
WORKER_CONCURRENCY=3

# Selfie quality checks (rarely need changing).
BLUR_THRESHOLD=25
DARK_THRESHOLD=45
BRIGHT_THRESHOLD=215

# Rate limits (requests per minute per IP).
RATE_LIMIT_ENABLED=true
MATCH_RATE_LIMIT_PER_MIN=10
LOGIN_RATE_LIMIT_PER_MIN=5

LOG_LEVEL=INFO

# --- Videos ------------------------------------------------------------------
# Max video upload size (bytes), frames sampled per second for face detection,
# and the cap on sampled frames per video (long videos are sampled sparser).
MAX_VIDEO_BYTES=524288000
VIDEO_SAMPLE_FPS=1.0
VIDEO_MAX_FRAMES=300
