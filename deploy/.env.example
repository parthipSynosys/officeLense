# Docker Compose variables (deploy/.env)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# Host directory for photos (nginx serves it at /photos/). Must be owned by uid 1000.
PHOTOS_HOST_DIR=/srv/eventlens/photos
# Host directory mounted read-only at /import in the worker, for bulk-index.
IMPORT_HOST_DIR=/srv/eventlens/import
